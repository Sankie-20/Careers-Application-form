# Portal URL + port (same variable as main site — drives listen port and public origin)
PUBLIC_CAREERS_APPLY_PORTAL_URL=http://localhost:8081
PORT=8081

# Main Astro site (metadata: GET /api/careers/apply-context)
CONTEXT_API_BASE_URL=http://localhost:4321
CAREERS_BASE_PATH=/careers

# n8n webhooks (same values as on the main site)
CAREERS_JOB_APPLICATION_WEBHOOK_URL=https://thezig.app.n8n.cloud/webhook-test/application-form
CAREERS_GENERAL_APPLICATION_WEBHOOK_URL=https://thezig.app.n8n.cloud/webhook-test/general-application

SITE_BRAND=The Zig Group
